# 复制为 .env 后修改；docker compose 和 deploy.sh 都会读取它

# 公开访问域名（不带协议或端口）
DOMAIN=localhost

# Docker 宿主机映射端口
HOST_PORT=8080

# 数据库
DB_NAME=python_db
DB_USER=b2b
DB_PASS=change-me-please
DB_ROOT_PASS=change-me-too

# deploy.sh 专用：nginx 监听端口
NGINX_PORT=8080

# 可选: 启用 Let's Encrypt (需独立 IP + 域名已解析)
# ENABLE_HTTPS=1
# ADMIN_EMAIL=you@example.com
